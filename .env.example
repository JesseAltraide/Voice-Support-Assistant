# Copy to .env and fill in. Never commit the filled-in file.
# Each deployed service only needs the variables marked for it.

# --- BOTH SERVICES -----------------------------------------------------------
# Supabase, server-side only. The service role key bypasses row-level security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret so only the agent server can call the MCP server. 32+ random characters.
MCP_AUTH_TOKEN=

# --- AGENT SERVER ONLY (the public one) --------------------------------------
ANTHROPIC_API_KEY=
# Bearer secret Vapi and the text endpoint send to the agent server. 32+ random characters.
AGENT_AUTH_TOKEN=
# Full URL of the MCP server, ending in /mcp. On Render this is the private service's
# internal address, for example http://relaypay-mcp:10000/mcp
MCP_SERVER_URL=
# Optional: defaults to claude-haiku-4-5-20251001
AGENT_MODEL=

# --- VAPI DASHBOARD CONFIG (not read by the server; kept here for reference) ---
# Set the assistant's model to Custom LLM -> <agent-url>/vapi/chat/completions
# Set its server URL to <agent-url>/vapi/server, both with the AGENT_AUTH_TOKEN as a bearer token.
# Set endCallPhrases to exactly ["goodbye for now"] so the server can end a call.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# --- HANDOFF EMAIL (agent server) ---------------------------------------------
# Where an escalation's handoff brief is sent. Without all of HOST, USER, APP_PASSWORD and
# SUPPORT_INBOX_EMAIL the dispatcher sends nothing and leaves the escalations pending, so
# they go out once this is filled in rather than being lost.
# For Gmail use an app password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
# The support team's inbox: where the brief goes. Never the caller's address.
SUPPORT_INBOX_EMAIL=

# --- LOCAL SEEDING ONLY -------------------------------------------------------
# Absolute path to the brief folder holding assets/seed-data/*.csv and the knowledge base.
# Only needed to run `npm run seed`.
BRIEF_DIR=
