{
  "name": "relaypay-voice-support-agent",
  "version": "1.0.0",
  "description": "RelayPay voice customer-support agent: Claude Agent SDK backend, MCP tool server, Supabase records, Vapi voice layer.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/start.ts",
    "start:agent": "tsx src/agent/server.ts",
    "start:mcp": "tsx src/mcp/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "seed": "node db/seed.mjs && node db/ingest-knowledge.mjs",
    "seed:support": "node db/seed-support-user.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/eval/run.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@supabase/supabase-js": "^2.117.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "nodemailer": "^10.0.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "vitest": "^5.0.2"
  }
}
